// =========================
// BILINGUAL FIELD LABELS
// =========================

String fieldLabel(String field, bool isHindi) {
  if (isHindi) return field;

  const labels = {
    'पूरा नाम': 'Full Name',
    'पिता का नाम': "Father's Name",
    'गोत्र (कुल)': 'Gotra',
    'गांव': 'Village',
    'तहसील': 'Tehsil',
    'जिला': 'District',
    'राज्य': 'State',
    'फर्म / कंपनी / संस्था का नाम': 'Firm / Company / Organization Name',
    'पूरा पता': 'Full Address',
    'पिन कोड': 'PIN Code',
    'मोबाइल नंबर (मुख्य)': 'Primary Mobile Number',
    'मोबाइल नंबर': 'Mobile Number',
    'व्हाट्सऐप नंबर (वैकल्पिक)': 'WhatsApp Number (Optional)',
    'ईमेल आईडी': 'Email Address',
    'लॉगिन यूज़रनेम (मोबाइल नंबर)': 'Username (Mobile Number)',
    'लॉगिन पासवर्ड': 'Login Password',
    'पासवर्ड की पुष्टि करें': 'Confirm Password',
  };

  return labels[field] ?? field;
}

String fieldHint(String field, bool isHindi) {
  if (isHindi) return 'अपना $field लिखें';

  return 'Enter ${fieldLabel(field, false)}';
}

