// =======================
// APP LANGUAGE (Global State)
// =======================

class AppLanguage extends ChangeNotifier {
  static final AppLanguage instance = AppLanguage._();
  AppLanguage._();

  bool isHindi = false;

  Locale get locale => isHindi ? const Locale('hi') : const Locale('en');

  String t(String hi, String en) => isHindi ? hi : en;

  void setHindi() {
    if (!isHindi) {
      isHindi = true;
      notifyListeners();
    }
  }

  void setEnglish() {
    if (isHindi) {
      isHindi = false;
      notifyListeners();
    }
  }

  void toggle() {
    isHindi ? setEnglish() : setHindi();
  }
}

