    currPinController.addListener(() {
      if (currPinController.text.length == 6) {
        PincodeService.loadData().then((_) {
          if (PincodeService.isValid(currPinController.text)) {
            setState(() {
              currCityController.text = PincodeService.getCity(currPinController.text);
              currStateController.text = PincodeService.getState(currPinController.text);
            });
          }
        });
      }
    });
  }

