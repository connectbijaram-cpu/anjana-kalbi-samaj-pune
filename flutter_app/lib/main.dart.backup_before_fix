  // =======================
  // FIELD BUILDER (Auto Controller Mapping)
  // =======================

  Widget _buildField(String field) {
    final isHindi = AppLanguage.instance.isHindi;
    final isUsername = field.contains('यूजरनेम');
    final isPassword = field.contains('पासवर्ड');
    final isWhatsapp = field.contains('व्हाट्सएप');

    TextEditingController? controller;
    TextInputType keyboard = TextInputType.text;

    // Controller Mapping
    if (field == 'पूरा नाम') {
      controller = nameController;
    } else if (field == 'पिता का नाम') {
      controller = fatherNameController;
    } else if (field == 'गोत्र (कुल)') {
      controller = gotraController;
    } else if (field == 'गाँव') {
      controller = permVillageController;
    } else if (field == 'पंचायत') {
      controller = permPanchayatController;
    } else if (field == 'पंचायत समिति') {
      controller = permPanchayatSamitiController;
    } else if (field == 'जिला') {
      controller = permDistrictController;
    } else if (field == 'राज्य') {
      controller = permStateController;
    } else if (field == 'पिन कोड') {
      controller = permPinController;
      keyboard = TextInputType.number;
    } else if (field == 'वर्तमान पता') {
      controller = currAddressController;
    } else if (field == 'शहर') {
      controller = currCityController;
    } else if (field == 'वर्तमान राज्य') {
      controller = currStateController;
    } else if (field == 'वर्तमान पिन कोड') {
      controller = currPinController;
      keyboard = TextInputType.number;
    } else if (field == 'व्यवसाय का पता') {
      controller = businessAddressController;
    } else if (field == 'व्यवसाय का शहर') {
      controller = businessCityController;
    } else if (field == 'व्यवसाय का राज्य') {
      controller = businessStateController;
    } else if (field == 'व्यवसाय का पिन कोड') {
      controller = businessPinController;
      keyboard = TextInputType.number;
    } else if (field == 'मोबाइल नंबर (मुख्य)') {
      controller = mobileController;
      keyboard = TextInputType.phone;
    } else if (field == 'व्हाट्सएप नंबर (वैकल्पिक)') {
      controller = whatsappController;
      keyboard = TextInputType.phone;
    } else if (field == 'ईमेल एड्रेस') {
      controller = emailController;
      keyboard = TextInputType.emailAddress;
    } else if (isUsername) {
      controller = usernameAutoController;
    } else if (field.contains('पुष्टि')) {
      controller = confirmPasswordController;
    } else if (isPassword) {
      controller = loginPasswordController;
    }

    return TextField(
      controller: controller,
      readOnly: isUsername,
      keyboardType: keyboard,
      obscureText: isPassword || field.contains('पुष्टि') ? (isPassword ? obscurePassword : obscureConfirmPassword) : false,
      decoration: InputDecoration(
        labelText: '${fieldLabel(field, isHindi)}${isWhatsapp ? "" : " *"}',
        hintText: fieldHint(field, isHindi),
        prefixIcon: isUsername
            ? const Icon(Icons.lock, color: Colors.grey)
            : null,
        suffixIcon: (isPassword || field.contains('पुष्टि'))
            ? IconButton(
                icon: Icon(
                  (isPassword ? obscurePassword : obscureConfirmPassword)
                      ? Icons.visibility_off
                      : Icons.visibility,
                  color: AppColors.maroon,
                ),
                onPressed: () {
                  setState(() {
                    if (isPassword) {
                      obscurePassword = !obscurePassword;
                    } else {
                      obscureConfirmPassword = !obscureConfirmPassword;
                    }
                  });
                },
              )
            : null,
        filled: true,
        fillColor: isUsername ? Colors.grey.shade200 : Colors.white,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(12),
        ),
        contentPadding: const EdgeInsets.symmetric(horizontal: 14, vertical: 14),
      ),
    );
  }
}

