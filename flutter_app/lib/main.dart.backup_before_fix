String fieldLabel(String field, bool isHindi) {
  if (isHindi) return field;

  const labels = {
    'पूरा नाम': 'Full Name',
    'पिता का नाम': "Father's Name",
    'गोत्र (कुल)': 'Gotra (Clan)',
    'गाँव': 'Village',
    'पंचायत': 'Panchayat',
    'पंचायत समिति': 'Panchayat Samiti',
    'जिला': 'District',
    'राज्य': 'State',
    'पिन कोड': 'PIN Code',
    'वर्तमान पता': 'Current Address',
    'शहर': 'City',
    'वर्तमान राज्य': 'Current State',
    'वर्तमान पिन कोड': 'Current PIN Code',
    'व्यवसाय का नाम': 'Business Name',
    'व्यवसाय का पता': 'Business Address',
    'व्यवसाय का शहर': 'Business City',
    'व्यवसाय का राज्य': 'Business State',
    'व्यवसाय का पिन कोड': 'Business PIN Code',
    'मोबाइल नंबर (मुख्य)': 'Primary Mobile Number',
    'व्हाट्सएप नंबर (वैकल्पिक)': 'WhatsApp Number (Optional)',
    'ईमेल एड्रेस': 'Email Address',
    'लॉगिन यूजरनेम (मोबाइल नंबर)': 'Username (Mobile Number)',
    'लॉगिन पासवर्ड': 'Login Password',
    'पासवर्ड की पुष्टि करें': 'Confirm Password',
  };

  return labels[field] ?? field;
}

String fieldHint(String field, bool isHindi) {
  if (isHindi) return 'अपना $field लिखें';
  return 'Enter ${fieldLabel(field, false)}';
}

